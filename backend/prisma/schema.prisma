datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id              Int      @id @default(autoincrement())
  username        String   @unique
  email           String   @unique
  password        String
  avatarUrl       String?
  avatarPositionX Int      @default(50)
  avatarPositionY Int      @default(50)
  profileBackgroundUrl String?
  backgroundPositionX Int  @default(50)
  backgroundPositionY Int  @default(50)
  bio             String?
  location        String?
  autoReplyMessage String?  // 被关注时自动回复内容，空则用默认「感谢关注」
  artworks  Artwork[]
  artworksAsArtist Artwork[]     @relation("ArtworkArtist")
  comments  Comment[]
  clientCommissions Commission[] @relation("ClientCommissions")
  artistCommissions Commission[] @relation("ArtistCommissions")
  conversationsAs1 Conversation[] @relation("ConversationParticipant1")
  conversationsAs2 Conversation[] @relation("ConversationParticipant2")
  conversationReads ConversationRead[]
  messagesSent      Message[]
  followings       Follow[]     @relation("FollowFollower")
  followers        Follow[]     @relation("FollowFollowing")
  artworkLikes     ArtworkLike[]
  favorites        Favorite[]
  viewsRecord      View[]
  notifications    Notification[] @relation("UserNotifications")
  notificationsFrom Notification[] @relation("UserFromNotifications")
  sessions         Session[]
  createdAt DateTime @default(now())
}

model Session {
  id               String   @id @default(cuid())
  userId           Int
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash String
  userAgent        String?
  ipAddress        String?
  createdAt        DateTime @default(now())
  lastActiveAt     DateTime @default(now())
  expiresAt        DateTime
  revokedAt        DateTime?
  revokedReason    String?

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

model Follow {
  id          Int  @id @default(autoincrement())
  followerId  Int
  followingId Int
  follower    User @relation("FollowFollower", fields: [followerId], references: [id], onDelete: Cascade)
  following   User @relation("FollowFollowing", fields: [followingId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  @@unique([followerId, followingId])
}

model Conversation {
  id             Int       @id @default(autoincrement())
  participant1Id Int
  participant2Id Int
  participant1   User      @relation("ConversationParticipant1", fields: [participant1Id], references: [id])
  participant2   User      @relation("ConversationParticipant2", fields: [participant2Id], references: [id])
  messages       Message[]
  reads          ConversationRead[]
  createdAt      DateTime  @default(now())
  @@unique([participant1Id, participant2Id])
}

model Message {
  id             Int          @id @default(autoincrement())
  conversationId Int
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       Int
  sender         User         @relation(fields: [senderId], references: [id])
  /// 稿件申请卡片等结构化消息可能较长，使用 TEXT 避免 VARCHAR(191) 截断导致 P2000
  content        String       @db.Text
  createdAt      DateTime     @default(now())
}

model ConversationRead {
  id             Int          @id @default(autoincrement())
  conversationId Int
  userId         Int
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastReadAt     DateTime     @default(now())

  @@unique([conversationId, userId])
  @@index([userId, conversationId])
}

model Artwork {
  id        Int      @id @default(autoincrement())
  title     String
  description String?
  imageUrl  String?
  category  String
  author    User     @relation(fields: [authorId], references: [id])
  authorId  Int
  artist    User?    @relation("ArtworkArtist", fields: [artistId], references: [id])
  artistId  Int?
  tags      String?
  gender    String?
  comments  Comment[]
  likes     Int      @default(0)
  views     Int      @default(0)
  artworkLikes ArtworkLike[]
  favorites    Favorite[]
  viewsRecord  View[]
  notifications Notification[] @relation("ArtworkNotifications")
  createdAt DateTime @default(now())
}

model View {
  id        Int     @id @default(autoincrement())
  userId    Int
  artworkId Int
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  artwork   Artwork @relation(fields: [artworkId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@unique([userId, artworkId])
}

model ArtworkLike {
  id        Int     @id @default(autoincrement())
  userId    Int
  artworkId Int
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  artwork   Artwork @relation(fields: [artworkId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@unique([userId, artworkId])
}

model Favorite {
  id        Int     @id @default(autoincrement())
  userId    Int
  artworkId Int
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  artwork   Artwork @relation(fields: [artworkId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@unique([userId, artworkId])
}

model Comment {
  id            Int           @id @default(autoincrement())
  content       String
  user          User          @relation(fields: [userId], references: [id])
  userId        Int
  artwork       Artwork       @relation(fields: [artworkId], references: [id])
  artworkId     Int
  parent        Comment?      @relation("CommentReplies", fields: [parentId], references: [id])
  parentId      Int?
  replies       Comment[]     @relation("CommentReplies")
  likes         Int           @default(0)
  createdAt     DateTime      @default(now())
  notifications Notification[]
}

model Notification {
  id         Int      @id @default(autoincrement())
  userId     Int      // 被通知的用户
  fromUserId Int?     // 触发通知的用户（如点赞/评论者）
  type       String   // like / comment 等
  artworkId  Int?
  commentId  Int?
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())

  user     User     @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)
  fromUser User?    @relation("UserFromNotifications", fields: [fromUserId], references: [id])
  artwork  Artwork? @relation("ArtworkNotifications", fields: [artworkId], references: [id], onDelete: Cascade)
  comment  Comment? @relation(fields: [commentId], references: [id], onDelete: SetNull)
}

model Commission {
  id             Int      @id @default(autoincrement())
  title          String
  description    String?
  category       String
  price          Int
  status         String
  paymentStatus  String
  paymentPercent Int?
  previewImageUrl String?

  submittedAt    DateTime
  confirmedAt    DateTime?
  startLabel     String?
  endLabel       String?

  /// 约稿广场方向：commission=我来约稿招人；offer=我来接稿找工作
  direction      String  @default("commission")

  client         User?    @relation("ClientCommissions", fields: [clientId], references: [id])
  clientId       Int?
  artist         User?    @relation("ArtistCommissions", fields: [artistId], references: [id])
  artistId       Int?

  createdAt      DateTime @default(now())
  /// 稿件信息最后变更时间；待确认被清空重新征集时更新，用于只认本轮申请
  updatedAt      DateTime @updatedAt

  /// 承接方取消验收时写入；下载交付仅统计此时间之后产生的 __COMMISSION_DELIVERY__ 消息
  lastDeliveryRoundAt DateTime?
}

