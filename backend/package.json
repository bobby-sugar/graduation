{
  "name": "backend",
  "version": "1.0.0",
  "description": "NestJS + Prisma backend for oc-web",
  "main": "dist/main.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "prisma:migrate": "prisma migrate dev",
